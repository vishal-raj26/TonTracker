{
  "name": "vaulton-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "verify:chart-loc": "node scripts/verify-chart-loc.js",
    "verify:source": "node scripts/verify-source-untouched.js",
    "start": "node scripts/railway-start.js",
    "dev": "node server.js",
    "build:edge": "node scripts/build-edge-static-assets.js",
    "dev:active": "node scripts/start-active-local.js",
    "worker:gift-snapshots": "node gift-snapshot-worker.js",
    "worker:gift-snapshots:once": "node gift-snapshot-once.js",
    "worker:gift-models:once": "node gift-model-snapshot-once.js",
    "worker:gift-combos": "node scripts/snapshot-gift-combos.js --continuous",
    "worker:gift-combos:once": "node scripts/snapshot-gift-combos.js",
    "worker:gift-sales": "node scripts/snapshot-gift-sales.js --continuous",
    "worker:gift-sales:once": "node scripts/snapshot-gift-sales.js",
    "worker:run": "node scripts/worker-dispatch.js",
    "valuation:export": "node scripts/export-valuation-read-model.js",
    "valuation:username-ledger": "node scripts/rebuild-username-ledger.js",
    "valuation:username-ledger:continuous": "node scripts/rebuild-username-ledger.js --continuous",
    "valuation:baselines": "node scripts/refresh-identity-baselines.js",
    "worker:telegram-floors": "node -e \"console.log('Telegram Marketplace floor scanning has been retired')\"",
    "worker:telegram-floors:once": "node -e \"console.log('Telegram Marketplace floor scanning has been retired')\"",
    "worker:estimate-history": "set ESTIMATE_HISTORY_CONTINUOUS=1&& node scripts/railway-start.js",
    "worker:dns-pipeline": "node scripts/dns-pipeline-worker.js",
    "worker:dns-pipeline:once": "node scripts/dns-pipeline-worker.js --once",
    "worker:dns-rates": "node scripts/dns-rate-worker.js",
    "worker:dns-rates:once": "node scripts/dns-rate-worker.js --once",
    "ingest:dns-d1:once": "cd dns-worker && python -m dns_worker direct-d1-once",
    "ingest:dns-d1:cycle": "cd dns-worker && python -m dns_worker direct-d1-cycle",
    "worker:usernames": "node scripts/username-pipeline-worker.js",
    "worker:usernames:once": "node scripts/username-pipeline-worker.js --once",
    "ingest:usernames": "node scripts/username-market-ingest.js --continuous",
    "ingest:usernames:once": "node scripts/username-market-ingest.js",
    "worker:usernames:semantic": "node scripts/username-semantic-worker.js --continuous",
    "worker:usernames:semantic:once": "node scripts/username-semantic-worker.js",
    "backtest:usernames": "node scripts/username-backtest.js",
    "audit:usernames": "node scripts/username-settlement-audit.js",
    "backtest:dns": "node scripts/dns-backtest.js",
    "migrate:dns": "node scripts/dns-migrate.js",
    "worker:gift-snapshots:15m": "set GIFT_SNAPSHOT_INTERVAL_MS=900000&& node gift-snapshot-worker.js",
    "ingest:gift-layers": "node scripts/ingest-giftchanges-layers.js"
  },
  "dependencies": {
    "@mtcute/convert": "0.31.0",
    "@mtcute/node": "0.31.0",
    "@ton/core": "^0.63.1",
    "@tonconnect/ui": "^2.4.4",
    "chart.js": "4.5.1",
    "lottie-web": "^5.12.2",
    "pg": "^8.13.1",
    "telegram": "^2.26.22"
  }
}
