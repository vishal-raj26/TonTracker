# Dedicated PostgreSQL instance for TON DNS. Do not point this at gift D1.
DNS_DATABASE_URL=postgresql://user:password@host:5432/tontrack_dns
# Direct compact D1 ingestion does not use DNS_DATABASE_URL.
D1_REGISTRY_URL=
D1_INGEST_SECRET=

DNS_SOURCE_BUCKET_URL=https://aws-public-blockchain.s3.us-east-2.amazonaws.com
DNS_SOURCE_NFT_ITEMS_PREFIX=v1.1/ton/nft_items/
DNS_SOURCE_NFT_METADATA_PREFIX=v1.1/ton/nft_metadata/
DNS_SOURCE_NFT_EVENTS_PREFIX=v1.1/ton/nft_events/
DNS_SOURCE_NFT_SALES_PREFIX=v1.1/ton/nft_sales/
# Bootstrap order is items -> metadata -> events/sales. Start far enough back to
# include the full collection; future discovery resumes from durable cursors.
# Optional inclusive ISO dates for a bounded backfill.
DNS_SOURCE_START_DATE=2022-01-01
# DNS_SOURCE_END_DATE=2026-08-13

DNS_INGEST_BATCH_SIZE=8
DNS_MAX_ATTEMPTS=5
DNS_JOB_LEASE_SECONDS=900
# Maximum matching DNS rows accepted from one object, regardless of stream.
DNS_MAX_EVENTS_PER_OBJECT=100000
DNS_MAX_OBJECT_BYTES=1073741824
DNS_DUCKDB_MEMORY_LIMIT=512MB
DNS_DUCKDB_THREADS=2
DNS_RETRY_BASE_SECONDS=2
DNS_HTTP_TIMEOUT_SECONDS=30
# Retry transient TON Center 429/5xx/network failures before the cron exits.
TONCENTER_RETRY_ATTEMPTS=3
DNS_LOG_LEVEL=INFO
# DNS_TEMP_DIR=/tmp/tontrack-dns
# DNS_WORKER_ID=railway-dns-market-1
