{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m dns_worker direct-d1-cycle --page-size 25",
    "cronSchedule": "*/5 * * * *",
    "restartPolicyType": "NEVER"
  }
}
