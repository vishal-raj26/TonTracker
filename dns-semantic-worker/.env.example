# Required operational PostgreSQL (contains dns_jobs and dns_semantic_profiles).
DNS_DATABASE_URL=postgresql://user:password@host:5432/tontrack_dns

# Durable queue behavior.
DNS_SEMANTIC_WORKER_ID=
DNS_SEMANTIC_JOB_TYPE=dns-semantic
DNS_SEMANTIC_BATCH_SIZE=24
DNS_SEMANTIC_POLL_SECONDS=5
DNS_SEMANTIC_LEASE_SECONDS=300
DNS_SEMANTIC_RETRY_BASE_SECONDS=15
DNS_SEMANTIC_RETRY_MAX_SECONDS=3600
DNS_SEMANTIC_RUN_ONCE=0
DNS_SEMANTIC_LOG_LEVEL=INFO
DNS_SEMANTIC_PROFILE_VERSION=semantic-v1
DNS_SEMANTIC_SCHEMA_VERSION=tontrack.dns.semantic-profile.v1
DNS_DICTIONARY_VERSION=dictionary-v1

# BGE-M3: disabled (deterministic only), http (OpenAI-compatible), or local.
DNS_EMBEDDING_PROVIDER=disabled
DNS_EMBEDDING_ENDPOINT=
DNS_EMBEDDING_API_KEY=
DNS_EMBEDDING_MODEL=BAAI/bge-m3
DNS_EMBEDDING_MODEL_VERSION=bge-m3-v1
DNS_EMBEDDING_BATCH_SIZE=32
DNS_EMBEDDING_REQUESTS_PER_SECOND=1
DNS_EMBEDDING_TIMEOUT_SECONDS=60
DNS_LOCAL_EMBEDDING_DEVICE=cpu

# Choose one vector target. Direct pgvector takes precedence over HTTP.
DNS_VECTOR_DATABASE_URL=
DNS_VECTOR_DIMENSIONS=1024
DNS_VECTOR_UPSERT_ENDPOINT=
DNS_VECTOR_API_KEY=
DNS_VECTOR_NAMESPACE=ton-dns
DNS_VECTOR_STORE_NAME=dns-pgvector
DNS_VECTOR_TIMEOUT_SECONDS=30

# Optional selective Qwen3-8B OpenAI-compatible chat endpoint.
DNS_QWEN_ENDPOINT=
DNS_QWEN_API_KEY=
DNS_QWEN_MODEL=Qwen/Qwen3-8B
DNS_QWEN_MODEL_VERSION=qwen3-8b-v1
DNS_QWEN_REQUESTS_PER_SECOND=0.25
DNS_QWEN_TIMEOUT_SECONDS=90
DNS_QWEN_CONFIDENCE_THRESHOLD=0.68
DNS_QWEN_HIGH_IMPACT_GRAM=500
# Use json_object or none only when the provider lacks strict json_schema support.
DNS_QWEN_RESPONSE_FORMAT=json_schema
